# Backend de la web comercial de NexoPOS. Copiar a .env y completar. Nunca subir .env al repositorio.

# Servidor
PORT=8787
NODE_ENV=production
# Número de proxies delante (Render, Fly, Nginx...). 0 si se expone directamente.
TRUST_PROXY=1
# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
ALLOWED_ORIGINS=https://avatarstark.github.io
# URL pública de la web (para los enlaces de gestionar la reserva).
PUBLIC_SITE_URL=https://avatarstark.github.io
# Servir también la web estática desde este servidor (1) o solo la API (0).
SERVE_STATIC=0

# PostgreSQL
DATABASE_URL=postgres://usuario:clave@host:5432/nexopos_web
# 1 si el proveedor exige SSL (Render, Neon, Supabase...).
DATABASE_SSL=1

# Sesiones del panel. Mínimo 32 caracteres aleatorios:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=

# Antispam opcional: Cloudflare Turnstile. Si se deja vacío, se usan honeypot, tiempo mínimo y límites por IP.
TURNSTILE_SECRET=

# Correo opcional (Resend). Sin estas variables no se envían correos y el sistema lo indica.
RESEND_API_KEY=
EMAIL_FROM=NexoPOS <demos@tu-dominio.com>
# Aviso interno al equipo comercial por cada reserva.
SALES_NOTIFY_EMAIL=

# WhatsApp opcional (WhatsApp Business Cloud API de Meta). Requiere una plantilla aprobada
# con 3 parámetros en el cuerpo: {{1}} nombre, {{2}} fecha y hora, {{3}} enlace para gestionar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es
